# Server Port
PORT=5000
NODE_ENV=development

# MySQL Relational Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=retro_store_db

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_retro_store
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email Service Credentials (for password reset)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=support@retrostore.in
